@page "/live"
@inherits LiveComponent
@inject WcsApi Api
@inject OperatorCommands Commands

<PageTitle>Live system · Ardán</PageTitle>

<div class="game @(_flat ? "is-flat" : null)">
    <h1 class="sr-only">Live system</h1>

    @if (!_flat)
    {
        <WorldView @ref="_world" Colour="_colour" Product="@_product" Highlight="@Highlight" Velocities="_velocities" Labels="_labels"
                   OnPick="SelectAsync" OnImmersive="on => _immersive = on" OnUnavailable="UseFlat" />
    }

    @if (Live is { } live)
    {
        <div class="hud">
            @if (_flat)
            {
                <div class="hud-stage">
                    <section class="card rack-card">
                        <RackView Colour="_colour" Product="@_product" SelectedLane="SelectedLane" SelectedTaxi="@SelectedTaxi" Velocities="_velocities"
                                  OnLaneSelected="lane => SelectAsync(Selection.Lane(lane.Level, lane.Bay))"
                                  OnTaxiSelected="id => SelectAsync(new Selection(SelectionKind.Taxi, id))" />
                    </section>
                </div>
            }
            <HudTop Live="live" OnGoals="() => _tab = GoalsTab" OnAlarms="FocusFirstAlarmAsync" />
            <div class="hud-left">
                <HudBoard @bind-Tab="_tab" Orders="_orders" Offers="Offers" Goals="live.Shift.Goals" Now="live.Time" Busy="@_accepting"
                          SelectedOrder="@(_selected is { Kind: SelectionKind.Order } order ? order.Id : null)"
                          OnSelectOrder="SelectOrderAsync" OnAccept="AcceptAsync" OnDismiss="offer => _dismissed.Add(offer.Id)" />
            </div>
            <div class="hud-right">
                @if (_selected is { } selected)
                {
                    <Inspector Selected="selected" Live="live" Lane="_lane" Orders="_orders" OnClose="() => SelectAsync(null)"
                               OnConfirm="confirmation => _confirm = confirmation" OnFind="code => _product = code" OnChanged="LoadOrdersAsync" />
                }
                <HudRail Live="live" @bind-Flat="_flat" @bind-Labels="_labels" Immersive="_immersive" @bind-Colour="_colour" @bind-Product="_product"
                         Skus="_skus" OnCommand="CommandAsync" />
            </div>
            <HudAlerts Live="live" OnSelect="SelectAlarmAsync" OnFix="alarm => _confirm = Commands.AlarmFix(alarm)" />
            @if (_banner is { } banner)
            {
                <div class="hud-banner" role="status" @key="banner.Seq">
                    <Icon Name="@(banner.Kind == ScoreKind.Level ? "trophy" : "flag")" Size="18" />
                    <span>@banner.Text</span>
                    @if (banner.Points > 0)
                    {
                        <strong>+@banner.Points</strong>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="game-wait"><Waiting /></div>
    }
</div>

<ConfirmDialog Request="_confirm" OnClose="() => _confirm = null" />

@code {
    private const string GoalsTab = "goals";
    private static readonly TimeSpan OrdersEvery = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan BannerFor = TimeSpan.FromSeconds(6);
    private readonly HashSet<string> _dismissed = [];
    private LaneColour _colour = LaneColour.Fill;
    private string? _product;
    private Selection? _selected;
    private LaneDetail? _lane;
    private IReadOnlyList<SkuView> _skus = [];
    private Dictionary<string, Velocity> _velocities = [];
    private IReadOnlyList<OrderView> _orders = [];
    private DateTime _ordersLoaded;
    private string _tab = "jobs";
    private bool _flat;
    private bool _labels = true;
    private bool _immersive;
    private string? _accepting;
    private Confirmation? _confirm;
    private WorldView? _world;
    private long _seen;
    private ScoreEvent? _banner;
    private DateTime _bannerUntil;

    protected override TimeSpan RefreshEvery => TimeSpan.FromMilliseconds(500);

    private IReadOnlyList<SuggestionView> Offers =>
        Live?.Suggestions.Where(offer => !_dismissed.Contains(offer.Id)).ToList() ?? [];

    private (int Level, int Bay)? SelectedLane => _selected?.TryLane(out var lane) == true ? (lane.Level, lane.Bay) : null;

    private string? SelectedTaxi => _selected is { Kind: SelectionKind.Taxi } taxi ? taxi.Id : null;

    private string? Highlight => _selected switch
    {
        { Kind: SelectionKind.Alarm } alarm => Live?.ActiveAlarms.FirstOrDefault(a => a.Id == alarm.Id) is { } active ? WorldView.SpotOf(active) : null,
        { Kind: SelectionKind.Order } => null,
        { Kind: SelectionKind.Reject } => "Reject",
        { } other => other.Id,
        null => null,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSkusAsync();
        await LoadOrdersAsync();
    }

    protected override async Task OnLiveAsync()
    {
        if (DateTime.UtcNow - _ordersLoaded > OrdersEvery) await LoadOrdersAsync();
        if (_skus.Count == 0) await LoadSkusAsync();
        if (_selected?.TryLane(out var id) == true && _lane is { } shown && Feed.LaneAt(id.Level, id.Bay) is { } latest && latest.Version != shown.Lane.Version)
            _lane = await Api.LaneAsync(id.Level, id.Bay) ?? _lane;
        WatchScore();
    }

    private async Task LoadSkusAsync()
    {
        _skus = await Api.SkusAsync();
        _velocities = _skus.ToDictionary(sku => sku.Code, sku => sku.Velocity);
    }

    private async Task LoadOrdersAsync()
    {
        _orders = await Api.OrdersAsync("open");
        _ordersLoaded = DateTime.UtcNow;
    }

    private async Task SelectAsync(Selection? selection)
    {
        _selected = selection;
        _lane = null;
        if (selection?.TryLane(out var lane) == true) _lane = await Api.LaneAsync(lane.Level, lane.Bay);
    }

    private async Task SelectOrderAsync(OrderView order)
    {
        if (_selected is { Kind: SelectionKind.Order } current && current.Id == order.Id)
        {
            await SelectAsync(null);
            return;
        }
        _product = order.SkuCode;
        await SelectAsync(new Selection(SelectionKind.Order, order.Id));
    }

    private async Task SelectAlarmAsync(AlarmView alarm)
    {
        await SelectAsync(new Selection(SelectionKind.Alarm, alarm.Id));
        if (_world is not null) await _world.FocusAsync(WorldView.SpotOf(alarm));
    }

    private async Task FocusFirstAlarmAsync()
    {
        if (Live?.ActiveAlarms.FirstOrDefault() is { } alarm) await SelectAlarmAsync(alarm);
    }

    private async Task AcceptAsync(SuggestionView offer)
    {
        _accepting = offer.Id;
        try
        {
            var result = await Commands.AcceptAsync(offer);
            if (!result.Ok) return;
            _dismissed.Add(offer.Id);
            await LoadOrdersAsync();
            if ((result.Ref ?? offer.OrderId) is { } orderId) await SelectAsync(new Selection(SelectionKind.Order, orderId));
        }
        finally
        {
            _accepting = null;
        }
    }

    private async Task CommandAsync(string name)
    {
        if (_world is not null) await _world.CommandAsync(name);
    }

    private void UseFlat() => _flat = true;

    private void WatchScore()
    {
        if (_banner is not null && DateTime.UtcNow > _bannerUntil) _banner = null;
        if (Live?.Shift.Events is not { Count: > 0 } events) return;
        var newest = events[0].Seq;
        if (_seen == 0)
        {
            _seen = newest;
            return;
        }
        var big = events.Where(item => item.Seq > _seen && item.Kind is ScoreKind.Goal or ScoreKind.Level).MaxBy(item => item.Seq);
        _seen = Math.Max(_seen, newest);
        if (big is null) return;
        _banner = big;
        _bannerUntil = DateTime.UtcNow + BannerFor;
    }
}
