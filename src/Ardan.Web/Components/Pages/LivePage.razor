@page "/live"
@inherits LiveComponent
@inject WcsApi Api

<PageTitle>Live system · Ardán</PageTitle>

<PageHeader Title="Live system" Subtitle="Front view of the rack, as seen from the dock. Updated four times a second.">
    <div class="field-inline">
        <span class="field-label">Colour lanes by <InfoTip Title="Colour lanes by" Text="Fill shows stored pallets and flags stock that expires within 3 days. Velocity shows how often a product moves. Expiry shows days left." Side="bottom" /></span>
        <Segmented Choices="Colours" Value="@_colour.ToString()" ValueChanged="SetColour" Label="Colour lanes by" />
    </div>
</PageHeader>

<div class="live-grid">
    <section class="card rack-card">
        <RackView Colour="_colour" Product="@_product" SelectedLane="_lane" SelectedTaxi="@_taxi" Velocities="_velocities"
                  OnLaneSelected="SelectLaneAsync" OnTaxiSelected="SelectTaxi" />
        <ul class="rack-legend">
            @foreach (var (swatch, text) in Legend())
            {
                <li><i class="swatch @swatch"></i>@text</li>
            }
        </ul>
    </section>

    <aside class="live-side">
        <section class="card">
            <CardHeader Title="Find a product" Help="Lights up every lane that holds the product. Other lanes fade so you can see where it is stored." />
            <select class="input" value="@(_product ?? "")" @onchange="SelectProduct" aria-label="Product to find">
                <option value="">All products</option>
                @foreach (var sku in _skus)
                {
                    <option value="@sku.Code">@sku.Name (@sku.Code)</option>
                }
            </select>
            @if (FoundSku is { } found)
            {
                <p class="find-result">
                    <strong>@found.Pallets pallets</strong> in @found.Lanes @(found.Lanes == 1 ? "lane" : "lanes")
                    @if (found.NextExpiry is { } next)
                    {
                        <span>· oldest best before @Display.Day(next)</span>
                    }
                </p>
            }
        </section>

        <section class="card selection">
            @if (SelectedTaxiView is { } taxi)
            {
                var look = Display.Look(taxi.State);
                <header class="selection-head">
                    <div>
                        <span class="drawer-kicker">Taxi</span>
                        <h2>@taxi.Id</h2>
                    </div>
                    <button type="button" class="icon-btn" @onclick="ClearSelection" aria-label="Clear selection"><Icon Name="x" /></button>
                </header>
                <StateBadge Look="look" Side="bottom" />
                <p class="selection-activity">@taxi.Activity</p>
                <dl class="facts">
                    <Fact Label="Battery"><BatteryMeter Value="taxi.Battery" Charging="taxi.State == TaxiState.Charging" /></Fact>
                    <Fact Label="Where">@(taxi.State == TaxiState.OnLift && taxi.LiftId is not null ? $"On {taxi.LiftId}" : taxi.X < 0.05 ? $"Dock, level {taxi.Level}" : $"Level {taxi.Level}, bay {Display.Num(taxi.X, "0.0")}")</Fact>
                    <Fact Label="Speed">@Display.Num(taxi.SpeedMs, "0.0") m/s</Fact>
                    <Fact Label="Carrying">@(taxi.PalletId is null ? "Nothing" : $"{taxi.PalletId} · {taxi.SkuName}")</Fact>
                </dl>
                <a class="btn btn-block" href="@($"fleet?select={taxi.Id}")">Open in Fleet <Icon Name="chevron-right" Size="15" /></a>
            }
            else if (_detail is { } detail)
            {
                var lane = detail.Lane;
                <header class="selection-head">
                    <div>
                        <span class="drawer-kicker">Lane</span>
                        <h2>L@(lane.Level)·B@(lane.Bay.ToString("00"))</h2>
                    </div>
                    <button type="button" class="icon-btn" @onclick="ClearSelection" aria-label="Clear selection"><Icon Name="x" /></button>
                </header>
                if (lane.SkuName is null)
                {
                    <p class="muted">Empty. The next batch that needs a lane at this level and distance can go here.</p>
                }
                else
                {
                    <p class="selection-activity"><strong>@lane.SkuName</strong> · batch @lane.Batch</p>
                    <div class="lane-meter">
                        <ProgressBar Value="lane.Count" Max="lane.Depth" />
                        <span>@lane.Count of @lane.Depth places</span>
                    </div>
                    <ol class="lane-pallets">
                        @foreach (var pallet in detail.Pallets)
                        {
                            <li>
                                <a href="@($"inventory?pallet={pallet.Id}")">@pallet.Id</a>
                                <span class="muted">@pallet.WeightKg kg</span>
                                <span class="badge tone-@Display.ExpiryTone(pallet.Expiry, Now)">@Display.Expiry(pallet.Expiry, Now)</span>
                            </li>
                        }
                    </ol>
                    <p class="hint">The top pallet is the next to leave. Each lane holds one batch, so its pallets share a best-before date.</p>
                }
                if (lane.Busy)
                {
                    <p class="note tone-info"><Icon Name="taxi" Size="15" />A Taxi is on its way to this lane.</p>
                }
            }
            else
            {
                <EmptyState Icon="map" Tone="neutral" Title="Nothing selected" Text="Click a lane to see its pallets, or a Taxi to see what it is doing." />
            }
        </section>
    </aside>
</div>

@code {
    private static readonly IReadOnlyList<Choice> Colours =
    [
        new(nameof(LaneColour.Fill), "Fill", "Stored pallets. Amber means it expires within 3 days."),
        new(nameof(LaneColour.Velocity), "Velocity", "How often a product moves: A fast, B medium, C slow."),
        new(nameof(LaneColour.Expiry), "Expiry", "Days left before the best-before date."),
    ];

    private LaneColour _colour = LaneColour.Fill;
    private string? _product;
    private (int Level, int Bay)? _lane;
    private string? _taxi;
    private LaneDetail? _detail;
    private IReadOnlyList<SkuView> _skus = [];
    private Dictionary<string, Velocity> _velocities = [];

    protected override TimeSpan RefreshEvery => TimeSpan.FromSeconds(1);

    private TaxiView? SelectedTaxiView => _taxi is null ? null : Live?.Taxis.FirstOrDefault(taxi => taxi.Id == _taxi);

    private SkuView? FoundSku => _product is null ? null : _skus.FirstOrDefault(sku => sku.Code == _product);

    protected override async Task OnInitializedAsync() => await LoadSkusAsync();

    protected override async Task OnLiveAsync()
    {
        if (_lane is { } lane && _detail is { } detail && Feed.LaneAt(lane.Level, lane.Bay) is { } latest && latest.Version != detail.Lane.Version)
            _detail = await Api.LaneAsync(lane.Level, lane.Bay) ?? _detail;
        if (_skus.Count == 0) await LoadSkusAsync();
    }

    private async Task LoadSkusAsync()
    {
        _skus = await Api.SkusAsync();
        _velocities = _skus.ToDictionary(sku => sku.Code, sku => sku.Velocity);
    }

    private void SetColour(string value) => _colour = Enum.Parse<LaneColour>(value);

    private async Task SelectProduct(ChangeEventArgs e)
    {
        var code = e.Value?.ToString();
        _product = string.IsNullOrEmpty(code) ? null : code;
        if (_product is not null) _skus = await Api.SkusAsync();
    }

    private async Task SelectLaneAsync(LaneView lane)
    {
        _taxi = null;
        _lane = (lane.Level, lane.Bay);
        _detail = await Api.LaneAsync(lane.Level, lane.Bay);
    }

    private void SelectTaxi(string id)
    {
        _lane = null;
        _detail = null;
        _taxi = id;
    }

    private void ClearSelection()
    {
        _lane = null;
        _detail = null;
        _taxi = null;
    }

    private IEnumerable<(string Swatch, string Text)> Legend() => _colour switch
    {
        LaneColour.Velocity =>
        [
            ("pip tone-v-a", "A · fast mover"),
            ("pip tone-v-b", "B · medium"),
            ("pip tone-v-c", "C · slow mover"),
            ("lane-busy", "Taxi on its way"),
            ("taxi-chip", "Taxi, with its number"),
        ],
        LaneColour.Expiry =>
        [
            ("pip tone-fresh", "More than a week"),
            ("pip tone-week", "Within 7 days"),
            ("pip tone-soon", "Within 3 days"),
            ("pip tone-expired", "Past best before"),
            ("lane-busy", "Taxi on its way"),
        ],
        _ =>
        [
            ("pip tone-fill", "One pallet"),
            ("pip tone-soon", "Expires within 3 days"),
            ("pip", "Free place"),
            ("lane-busy", "Taxi on its way"),
            ("taxi-chip", "Taxi, with its number"),
        ],
    };
}
