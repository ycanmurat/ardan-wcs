@page "/fleet"
@inherits LiveComponent
@inject OperatorCommands Commands
@inject NavigationManager Nav

<PageTitle>Fleet · Ardán</PageTitle>

@if (Live is not { } live)
{
    <PageHeader Title="Fleet" Subtitle="Taxis, VTUs and conveyors." />
    <Waiting />
}
else
{
    var levels = Feed.Layout?.Levels ?? 6;
    var stopped = Stopped(live);
    var waiting = live.Taxis.Count(taxi => taxi.State is TaxiState.WaitingForAisle or TaxiState.WaitingForLift);
    var battery = live.Taxis.Count == 0 ? 0 : live.Taxis.Average(taxi => taxi.Battery);
    <PageHeader Title="Fleet" Subtitle="@Summary(live)">
        <a class="btn" href="live"><Icon Name="live" Size="16" />Watch in 3D</a>
    </PageHeader>

    <div class="stat-strip">
        <StatTile Icon="route" Label="Taxis on a job" Value="@live.Taxis.Count(taxi => taxi.JobId is not null).ToString()" Unit="@($"of {live.Taxis.Count}")" Tone="brand" />
        <StatTile Icon="bolt" Label="Charging" Value="@live.Taxis.Count(taxi => taxi.State == TaxiState.Charging).ToString()" Tone="ok" />
        <StatTile Icon="clock" Label="Waiting for an aisle or VTU" Value="@waiting.ToString()" Tone="@(waiting > 0 ? "warn" : "neutral")" />
        <StatTile Icon="warning" Label="Stopped" Value="@stopped.ToString()" Tone="@(stopped > 0 ? "crit" : "neutral")" />
        <StatTile Icon="gauge" Label="Average battery" Value="@Display.Num(battery, "0")" Unit="%" Tone="@(battery < 35 ? "warn" : "ok")" />
    </div>

    <section class="machine-group">
        <CardHeader Title="Taxis" Help="Battery pallet shuttles. A Taxi drives along one level and rides a VTU to reach another. It charges at the dock whenever it stops there. Below 20% it goes to charge after its job." />
        <div class="machine-grid">
            @foreach (var taxi in live.Taxis)
            {
                <TaxiCard @key="taxi.Id" Taxi="taxi" Levels="levels" Selected="IsSelected(taxi.Id)" OnOpen="Open" OnConfirm="Confirm" />
            }
        </div>
    </section>

    <div class="grid grid-half">
        <section class="machine-group">
            <CardHeader Title="Vertical lifts (VTUs)" Help="Each VTU carries one Taxi at a time between levels, loaded or empty, at up to 1.2 m/s. Taxis queue at the dock for the first free one." />
            <div class="machine-list">
                @foreach (var lift in live.Lifts)
                {
                    <LiftCard @key="lift.Id" Lift="lift" Levels="levels" Selected="IsSelected(lift.Id)" OnOpen="Open" OnConfirm="Confirm" />
                }
            </div>
        </section>
        <section class="machine-group">
            <CardHeader Title="Conveyors" Help="The infeed brings pallets from goods-in to the rack, with a profile check at the start. The outfeed takes pallets to docks 1 to 3. Both run at 0.18 m/s." />
            <div class="machine-list">
                @foreach (var belt in live.Conveyors)
                {
                    <BeltCard @key="belt.Id" Belt="belt" OnConfirm="Confirm" />
                }
            </div>
        </section>
    </div>

    <Drawer Open="SelectedTaxi is not null" Kicker="Taxi" Title="@(SelectedTaxi?.Id ?? "")" Subtitle="@SelectedTaxi?.Activity" OnClose="Close">
        <ChildContent>
            @if (SelectedTaxi is { } taxi)
            {
                <div class="drawer-state">
                    <StateBadge Look="Display.Look(taxi.State)" Side="bottom" />
                    @if (!taxi.InService)
                    {
                        <Badge Text="Out of service" Tone="neutral" />
                    }
                    @if (taxi.ChargeHold)
                    {
                        <Badge Text="Charging to 95%" Tone="ok" />
                    }
                </div>
                if (taxi.FaultCode is not null)
                {
                    <div class="note tone-crit">
                        <Icon Name="warning" Size="16" />
                        <span>Stopped by a safety sensor (@taxi.FaultCode). Check the aisle on level @taxi.Level is clear before you reset it. If nobody does, remote support resets it after a camera check.</span>
                    </div>
                }
                <div class="drawer-hero">
                    <Gauge Value="taxi.Battery" Label="battery" Charging="taxi.State == TaxiState.Charging" Size="76" />
                    <LevelMeter Levels="levels" Position="taxi.Level" Moving="taxi.State == TaxiState.OnLift" Label="@Display.Where(taxi)" />
                    <div class="drawer-route">
                        <span class="muted">@(taxi.JobKind is null ? "No job" : taxi.JobKind == JobKind.Putaway ? "Into store" : "Out of store")</span>
                        <strong>@(taxi.JobKind is null ? Display.Where(taxi) : $"{taxi.From} → {taxi.To}")</strong>
                    </div>
                </div>
                <dl class="facts">
                    <Fact Label="Where">@Display.Where(taxi)</Fact>
                    <Fact Label="Speed" Help="1.8 m/s empty and 1.4 m/s loaded.">@Display.Num(taxi.SpeedMs, "0.0") m/s</Fact>
                    <Fact Label="Carrying">@(taxi.PalletId is null ? "Nothing" : $"{taxi.PalletId} · {taxi.SkuName}")</Fact>
                    <Fact Label="Job">@(taxi.JobId is null ? "None" : $"{taxi.JobId} · {(taxi.JobKind == JobKind.Putaway ? "putaway" : "retrieval")}")</Fact>
                    <Fact Label="Motor">@Display.Num(taxi.MotorTempC, "0.0") °C</Fact>
                    <Fact Label="Wi-Fi"><SignalBars Bars="taxi.Signal" /></Fact>
                    <Fact Label="Distance" Help="Distance driven since the control server started.">@Display.Num(taxi.DistanceKm, "0.00") km</Fact>
                    <Fact Label="Battery" Help="Above 30% it takes new jobs. Below 20% it goes to charge after its job.">@Display.Num(taxi.Battery, "0")%</Fact>
                </dl>
                <h3 class="drawer-section">What the actions do</h3>
                <ul class="action-help">
                    <li><strong>Send to charge.</strong> It finishes its job, then charges to 95% before it takes new work.</li>
                    <li><strong>Take out of service.</strong> It parks at the dock and gets no jobs. Use this before maintenance.</li>
                    <li><strong>Reset.</strong> Only after a stop, once the area is clear.</li>
                </ul>
            }
        </ChildContent>
        <Footer>
            @if (SelectedTaxi is { } taxi)
            {
                if (taxi.FaultCode is not null)
                {
                    <button type="button" class="btn btn-danger" @onclick="() => ConfirmTaxi(taxi, TaxiCommand.Reset)"><Icon Name="reset" Size="16" />Reset @taxi.Id</button>
                }
                else
                {
                    <Tip Text="@OperatorCommands.ChargeHelp(taxi)">
                        <button type="button" class="btn" disabled="@(!taxi.InService || taxi.ChargeHold)" @onclick="() => ConfirmTaxi(taxi, TaxiCommand.Charge)"><Icon Name="bolt" Size="16" />Send to charge</button>
                    </Tip>
                    if (taxi.InService)
                    {
                        <Tip Text="@OperatorCommands.ParkHelp(taxi)">
                            <button type="button" class="btn" disabled="@(taxi.JobId is not null)" @onclick="() => ConfirmTaxi(taxi, TaxiCommand.Park)"><Icon Name="pause" Size="16" />Take out of service</button>
                        </Tip>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="() => ConfirmTaxi(taxi, TaxiCommand.Resume)"><Icon Name="play" Size="16" />Return to service</button>
                    }
                }
            }
        </Footer>
    </Drawer>

    <Drawer Open="SelectedLift is not null" Kicker="VTU" Title="@(SelectedLift?.Id ?? "")" Subtitle="@SelectedLift?.Activity" OnClose="Close">
        <ChildContent>
            @if (SelectedLift is { } lift)
            {
                <div class="drawer-state"><StateBadge Look="Display.Look(lift.State)" Side="bottom" /></div>
                if (lift.FaultCode is not null)
                {
                    <div class="note tone-crit">
                        <Icon Name="warning" Size="16" />
                        <span>Stopped by a drive fault (@lift.FaultCode). Taxis that need it wait at the dock. Reset it once the shaft is clear.</span>
                    </div>
                }
                <div class="drawer-hero">
                    <LevelMeter Levels="levels" Position="lift.Position" Moving="lift.State is LiftState.Moving or LiftState.Carrying"
                                Label="@($"At level {Display.Num(lift.Position, "0.0")}")" />
                    <div class="drawer-route">
                        <span class="muted">@(lift.TaxiId is null ? "No Taxi on board" : lift.Loaded ? "Carrying a loaded Taxi" : "Carrying an empty Taxi")</span>
                        <strong>Level @Display.Num(lift.Position, "0.0")</strong>
                    </div>
                </div>
                <dl class="facts">
                    <Fact Label="Shaft">@(lift.Shaft + 1)</Fact>
                    <Fact Label="Position">Level @Display.Num(lift.Position, "0.0")</Fact>
                    <Fact Label="On board">@(lift.TaxiId is null ? "No Taxi" : $"{lift.TaxiId}{(lift.Loaded ? ", with a pallet" : ", empty")}")</Fact>
                    <Fact Label="Queue" Help="Taxis waiting at the dock for this VTU.">@lift.Waiting</Fact>
                    <Fact Label="Load limit">2,000 kg</Fact>
                    <Fact Label="Speed">Up to 1.2 m/s</Fact>
                </dl>
            }
        </ChildContent>
        <Footer>
            @if (SelectedLift is { FaultCode: not null } lift)
            {
                <button type="button" class="btn btn-danger" @onclick="() => _confirm = Commands.ResetLift(lift)"><Icon Name="reset" Size="16" />Reset @lift.Id</button>
            }
            else
            {
                <span class="muted">No actions needed while it runs.</span>
            }
        </Footer>
    </Drawer>

    <ConfirmDialog Request="_confirm" OnClose="() => _confirm = null" />
}

@code {
    private Confirmation? _confirm;

    [SupplyParameterFromQuery(Name = "select")] public string? Select { get; set; }

    protected override TimeSpan RefreshEvery => TimeSpan.FromMilliseconds(500);

    private TaxiView? SelectedTaxi => Select is null ? null : Live?.Taxis.FirstOrDefault(taxi => IsSelected(taxi.Id));

    private LiftView? SelectedLift => Select is null ? null : Live?.Lifts.FirstOrDefault(lift => IsSelected(lift.Id));

    private bool IsSelected(string id) => id.Equals(Select, StringComparison.OrdinalIgnoreCase);

    private void Open(string id) => Nav.NavigateTo($"fleet?select={id}", replace: true);

    private void Close() => Nav.NavigateTo("fleet", replace: true);

    private void Confirm(Confirmation confirmation) => _confirm = confirmation;

    private void ConfirmTaxi(TaxiView taxi, TaxiCommand command) => _confirm = Commands.Taxi(taxi, command);

    private static int Stopped(LiveSnapshot live) =>
        live.Taxis.Count(taxi => taxi.FaultCode is not null)
        + live.Lifts.Count(lift => lift.FaultCode is not null)
        + live.Conveyors.Count(belt => belt.State == ConveyorState.Jammed);

    private static string Summary(LiveSnapshot live)
    {
        var text = $"{live.Taxis.Count} Taxis, {live.Lifts.Count} VTUs and {live.Conveyors.Count} conveyors";
        var notes = new List<string>();
        if (Stopped(live) is > 0 and var stopped) notes.Add($"{stopped} stopped");
        if (live.Taxis.Count(taxi => !taxi.InService) is > 0 and var parked) notes.Add($"{parked} out of service");
        return notes.Count == 0 ? $"{text}. All running." : $"{text}. {string.Join(", ", notes)}.";
    }
}
