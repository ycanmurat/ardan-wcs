<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="reconnect">
        <span class="spinner reconnect-spinner" aria-hidden="true"></span>
        <p class="components-reconnect-first-attempt-visible">Reconnecting to the screen server…</p>
        <p class="components-reconnect-repeated-attempt-visible">Still trying. Next attempt in <span id="components-seconds-to-next-attempt"></span> s.</p>
        <p class="components-reconnect-failed-visible">Couldn't reconnect. Retry, or reload the page.</p>
        <button id="components-reconnect-button" class="btn btn-primary components-reconnect-failed-visible">Retry</button>
        <p class="components-pause-visible">This screen was paused by the server.</p>
        <p class="components-resume-failed-visible">Couldn't resume. Retry, or reload the page.</p>
        <button id="components-resume-button" class="btn btn-primary components-pause-visible components-resume-failed-visible">Resume</button>
    </div>
</dialog>
