<div class="ring" role="img" aria-label="@Display.Percent(Share) full">
    <svg viewBox="0 0 120 120">
        <circle class="ring-track" cx="60" cy="60" r="50" />
        <circle class="ring-value" cx="60" cy="60" r="50" transform="rotate(-90 60 60)"
                stroke-dasharray="@Display.Num(Circumference * Math.Clamp(Share, 0, 1)) @Display.Num(Circumference)" />
    </svg>
    <div class="ring-label">
        <strong>@Display.Percent(Share)</strong>
        <span>@Caption</span>
    </div>
</div>

@code {
    private static readonly double Circumference = 2 * Math.PI * 50;

    [Parameter] public double Share { get; set; }
    [Parameter] public string Caption { get; set; } = "full";
}
