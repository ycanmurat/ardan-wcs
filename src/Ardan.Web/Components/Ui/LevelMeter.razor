<span class="level-meter @(Moving ? "is-moving" : null)" role="img" aria-label="@Label">
    @for (var level = Levels - 1; level >= 0; level--)
    {
        var here = Math.Abs(Position - level) < 0.5;
        <span class="level-meter-step @(here ? "is-here" : null)"><i></i><small>L@(level)</small></span>
    }
</span>

@code {
    [Parameter] public int Levels { get; set; } = 6;
    [Parameter] public double Position { get; set; }
    [Parameter] public bool Moving { get; set; }
    [Parameter] public string Label { get; set; } = "";
}
