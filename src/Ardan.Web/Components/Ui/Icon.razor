<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Display.Num(Stroke)" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="@Icons.PathOf(Name)" />
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public double Stroke { get; set; } = 1.8;
    [Parameter] public string? Class { get; set; }
}
