<span class="gauge tone-@Tone" role="img" aria-label="@($"{Label} {Display.Num(Value, "0")}%")" style="--size: @(Size)px">
    <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <circle class="gauge-track" cx="32" cy="32" r="27" />
        <circle class="gauge-value" cx="32" cy="32" r="27" transform="rotate(-90 32 32)"
                stroke-dasharray="@Display.Num(Circumference * Math.Clamp(Value / 100, 0, 1)) @Display.Num(Circumference)" />
    </svg>
    <span class="gauge-label">
        <strong>@Display.Num(Value, "0")<small>%</small></strong>
        @if (Charging)
        {
            <Icon Name="bolt" Size="12" Class="gauge-bolt" />
        }
        else
        {
            <span>@Label</span>
        }
    </span>
</span>

@code {
    private static readonly double Circumference = 2 * Math.PI * 27;

    [Parameter] public double Value { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Charging { get; set; }
    [Parameter] public int Size { get; set; } = 64;

    private string Tone => Value switch
    {
        < 20 => "crit",
        < 35 => "warn",
        _ => "ok",
    };
}
